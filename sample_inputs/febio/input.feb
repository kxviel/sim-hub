<?xml version="1.0" encoding="ISO-8859-1"?>
<febio_spec version="3.0">
  <Module type="solid"/>
 
  <Control>
    <time_steps>10</time_steps>
    <step_size>0.1</step_size>
    <analysis>STATIC</analysis>
   
    <solver>
      <max_refs>15</max_refs>
      <dtol>0.001</dtol>
      <etol>0.01</etol>
      <rtol>0</rtol>
      <lstol>0.9</lstol>
      <qn_method type="BFGS">
        <max_ups>10</max_ups>
      </qn_method>
    </solver>
   
    <time_stepper type="default">
      <dtmin>0.001</dtmin>
      <dtmax>0.1</dtmax>
      <max_retries>5</max_retries>
    </time_stepper>
  </Control>
 
  <Material>
    <material id="1" name="CubeMaterial" type="neo-Hookean">
      <E>1000.0</E>
      <v>0.3</v>
    </material>
  </Material>
 
  <Mesh>
    <!-- Define the 8 corners of the cube -->
    <Nodes name="CubeNodes">
      <node id="1">0, 0, 0</node>
      <node id="2">1, 0, 0</node>
      <node id="3">1, 1, 0</node>
      <node id="4">0, 1, 0</node>
      <node id="5">0, 0, 1</node>
      <node id="6">1, 0, 1</node>
      <node id="7">1, 1, 1</node>
      <node id="8">0, 1, 1</node>
    </Nodes>
   
    <!-- Connect the nodes into a single hex8 element -->
    <Elements type="hex8" name="CubeElements">
      <elem id="1">1, 2, 3, 4, 5, 6, 7, 8</elem>
    </Elements>
   
    <!-- Tag the bottom face nodes (Z=0) -->
    <NodeSet name="FixedBase">
      <n id="1"/> <n id="2"/> <n id="3"/> <n id="4"/>
    </NodeSet>
   
    <!-- Tag the top face nodes (Z=1) -->
    <NodeSet name="PulledTop">
      <n id="5"/> <n id="6"/> <n id="7"/> <n id="8"/>
    </NodeSet>
  </Mesh>
 
  <MeshDomains>
    <SolidDomain name="CubeElements" mat="CubeMaterial"/>
  </MeshDomains>
 
  <Boundary>
    <!-- Fix the bottom face in all directions -->
    <bc name="FixBottom" type="fix" node_set="FixedBase">
      <dofs>x,y,z</dofs>
    </bc>
   
    <!-- Apply a prescribed displacement to the top face in the Z direction -->
    <bc name="PullTop" type="prescribe" node_set="PulledTop">
      <dof>z</dof>
      <scale lc="1">0.5</scale>
    </bc>
  </Boundary>
 
  <LoadData>
    <!-- Define how the displacement scales over time (linear ramp) -->
    <load_controller id="1" type="loadcurve">
      <interpolate>LINEAR</interpolate>
      <points>
        <point>0,0</point>
        <point>1,1</point>
      </points>
    </load_controller>
  </LoadData>
 
  <Output>
    <plotfile type="febio">
      <var type="displacement"/>
      <var type="stress"/>
    </plotfile>
    <logfile>
      <!-- Changed from z-stress to sz -->
      <element_data data="sz"/>
    </logfile>
  </Output>
</febio_spec>